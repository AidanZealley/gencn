{
  "name": "gencn",
  "version": "0.1.0",
  "description": "Generative UI from your own shadcn components: block definitions, view checks and a json-render renderer.",
  "keywords": [
    "generative-ui",
    "shadcn",
    "json-render",
    "llm",
    "mcp"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AidanZealley/gencn.git",
    "directory": "packages/core"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build",
    "prepack": "cp ../../LICENSE ."
  },
  "dependencies": {
    "@json-render/core": "^0.23.2",
    "@json-render/react": "^0.23.2",
    "re2js": "^2.10.0",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "react": "^19.2.3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
