{
  "name": "@gencn/core",
  "version": "0.1.0",
  "description": "Generative UI from your own shadcn components: block definitions, view checks and a json-render renderer.",
  "keywords": [
    "generative-ui",
    "shadcn",
    "json-render",
    "llm",
    "mcp"
  ],
  "repository": {
    "type": "git",
    "url": "TODO: gencn's repository URL"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "re2js": "^2.10.0"
  },
  "peerDependencies": {
    "@json-render/core": "^0.23.2",
    "@json-render/react": "^0.23.2",
    "react": "^19",
    "zod": "^4.3.6"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@json-render/core": "0.23.2",
    "@json-render/react": "0.23.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "4.6.7"
  }
}
